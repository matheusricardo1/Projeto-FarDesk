# development | test | production — muda comportamento (CORS default, mensagens de erro 500 verbosas ou não).
NODE_ENV=development
PORT=3000

# CSV de origens permitidas pro CORS. Vazio em dev usa um default seguro
# (localhost); vazio em produção bloqueia tudo — defina explicitamente antes
# de apontar o app pra um backend de produção.
ALLOWED_ORIGINS=http://localhost:3000

# Chave mestra usada pra cifrar (AES-256-GCM) os segredos de integração de
# cada conta em repouso (ex: client_secret do OAuth client do Tailscale).
# Gere com: openssl rand -base64 32
# Em produção, troque por um valor vindo de um KMS/secrets manager — nunca
# comite o valor real deste arquivo.
INTEGRATIONS_MASTER_KEY=

# Chave simétrica usada pra assinar (HS256) a sessão própria do FarDesk
# emitida depois do login com Google. Gere com: openssl rand -base64 32
AUTH_JWT_SECRET=

# Credenciais do OAuth client do Google (console.cloud.google.com → APIs e
# serviços → Credenciais → Criar ID do cliente OAuth → "Aplicativo da Web").
# GOOGLE_REDIRECT_URI precisa ser EXATAMENTE a URL pública deste backend +
# /auth/google/callback, e precisa estar cadastrada nas "URIs de redirect
# autorizados" do client no console do Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
